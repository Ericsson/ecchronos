# Network prefix (first three octets) for the integration test cluster.
#
# This is the single place to change the test subnet. Node and agent addresses are
# derived from it as <prefix>.2 .. <prefix>.8 and the network is <prefix>.0/24.
# Read by docker compose, generate_certificates.sh and the Python integration tests.
# An environment variable with the same name takes precedence over this file.
ECC_TEST_NET_PREFIX=172.24.0
